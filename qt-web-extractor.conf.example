# Configuration for qt-web-extractor
# Located at /etc/qt-web-extractor.conf
# Enable and start with: systemctl enable --now qt-web-extractor

# Listen address and port
HOST=127.0.0.1
PORT=8766

# Page load timeout in milliseconds. For fetch_pdf image mode, this is the
# operation-wide budget for loading the PDF and rendering all selected pages.
TIMEOUT_MS=30000

# Custom User-Agent (empty = default Chromium UA)
#USER_AGENT=

# API key for Bearer token auth (empty = no auth)
#API_KEY=

# Allow the server to read local files (file:// URLs, local paths) on
# behalf of clients. Off by default.
#ALLOW_LOCAL_FILES=

# Total memory budget in bytes for cached PDF downloads (default: 64 MiB)
#PDF_CACHE_MAX_BYTES=67108864

# Maximum PDF pages rendered per fetch_pdf image-mode call (default: 10)
#PDF_MAX_RENDER_PAGES=10

# Seconds a cached PDF download stays reusable (default: 600)
#PDF_CACHE_TTL_S=600

# Standard outbound proxy environment variables.
# Applies to both Chromium (Qt WebEngine) and HTTP fallback requests.
# Only HTTP/HTTPS forward proxies are supported end-to-end.
#HTTPS_PROXY=http://127.0.0.1:7890
#HTTP_PROXY=http://127.0.0.1:7890
#ALL_PROXY=http://127.0.0.1:7890
#NO_PROXY=127.0.0.1,localhost,.internal.example
